# ==============================================================================
# Pedidos360 Enterprise - Variables de Entorno de Despliegue Remoto (Vite)
# NOTA: En Evaluación 3 está PROHIBIDO depender de localhost hardcodeado.
# Configura estas variables apuntando a tus IPs públicas de AWS EC2 o API Gateway.
# ==============================================================================

# 1. Autenticación Microsoft Entra ID (OAuth 2.0 / OIDC con PKCE)
VITE_AZURE_CLIENT_ID=5f5ad1dc-7259-4d00-a29d-75f1c2b3b2f4
VITE_AZURE_TENANT_ID=e5372bf0-c5e3-4286-887c-79069f209c1f
VITE_AZURE_REDIRECT_URI=

# 2. Microservicio de Pagos & Detección Antifraude (ms-pago + Webpay Plus)
VITE_PAGOS_API_URL=http://127.0.0.1:8085

# 3. Microservicio de Analítica, Kafka & Recomendaciones (ms-analytics-recommendations)
VITE_RECOMENDACIONES_API_URL=http://127.0.0.1:8086

# 4. WebSocket Streaming en Tiempo Real (+3 pts extra)
VITE_WS_URL=ws://127.0.0.1:8086/ws-analytics-raw

# 5. Microservicios del Ecosistema Cloud Native
VITE_CATALOGO_API_URL=http://127.0.0.1:8080
VITE_CARRITO_API_URL=http://127.0.0.1:8081
VITE_NOTIFICACIONES_API_URL=http://127.0.0.1:8082
VITE_AUDITORIA_API_URL=http://127.0.0.1:8083
VITE_ADMIN_API_URL=http://127.0.0.1:8084

# 6. AWS API Gateway Perimetral (opcional)
VITE_API_GATEWAY_URL=https://op6erfwwmh.execute-api.us-east-1.amazonaws.com/v1
